{
  "name": "pralis-portal-admissao",
  "version": "0.1.0",
  "private": true,
  "description": "Portal provisorio de admissao da Padaria Pralis - cadastro de colaboradores para o Departamento Pessoal.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit && vite build",
    "build:skip-check": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b --noEmit",
    "lint": "eslint . --ext .vue,.ts",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "pinia": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/tsconfig": "^0.5.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vue-tsc": "^2.0.29"
  }
}
