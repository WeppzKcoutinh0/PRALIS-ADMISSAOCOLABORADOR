# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Aplicacao
VITE_APP_NAME=Portal de Admissao Pralis
VITE_APP_ENV=development

# Edge Function publica (cadastro do colaborador)
